# P1-owned configuration. Use fresh values; never use Core Platform credentials.
CLIENT_STACK_ID=p1-land-management
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/p1_local
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
SETUP_TOKEN=replace-with-a-unique-setup-token
PORT=5001
APP_URL=http://localhost:5001
PUBLIC_SITE_ORIGIN=http://localhost:4180
CORE_PLATFORM_ADMIN_ORIGIN=http://localhost:4180
TRUSTED_ORIGINS=http://localhost:4180,http://localhost:5001
CLIENT_SITE_MANIFEST_PATH=config/p1-client-site-manifest.json
CLIENT_SITE_CORE_VERSION=1.0.0
# Production origins are all https://www.p1landmanagement.com; dashboard lives at /admin.
# Railway private PostgreSQL: DATABASE_TLS_MODE=private (requires Railway environment identity).
# External PostgreSQL: DATABASE_TLS_MODE=verify-full and trusted DATABASE_TLS_CA where needed.
# Optional server-to-server estimate proxy secret; never expose it in a frontend build.
# CLIENT_FORM_PROXY_TOKEN=
# Dedicated P1 object storage/provider values: see docs/P1-OPERATIONS.md.
