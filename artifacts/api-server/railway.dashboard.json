{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "artifacts/api-server/Dockerfile.dashboard"
  },
  "deploy": {
    "healthcheckPath": "/api/healthz",
    "preDeployCommand": "node dist/dashboard/migrate.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "startCommand": "node dist/dashboard/main.js"
  }
}
