                "schema": {
                  "$ref": "#/components/schemas/DashboardError"
                }
              }
            }
          },
          "409": {
            "description": "Stale version or state conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommercialFollowUp"
              }
            }
          }
        }
      }
    },
    "/schedule": {
      "get": {
        "operationId": "getSchedule",
        "description": "Up to32 inclusive New York dates. Pages contain100 items. Crew assigned work only; clients granted accounts only. Unscheduled mode is forbidden to clients.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchedulePage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardError"
                }
              }
            }
          },
          "401": {
            "description": "Verified session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardError"
                }
              }
            }
          },
          "403": {
            "description": "Role or owner assurance required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardError"
                }
              }
            }
          },
          "404": {
            "description": "Record absent or private",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardError"
                }
              }
            }
          },
          "409": {
            "description": "Stale version or state conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "through",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "unscheduled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 400
            }
          }
        ]
      }
    },
