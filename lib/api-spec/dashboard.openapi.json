    "/me": {
      "get": {
        "operationId": "getDashboardMe",
        "description": "Verified identity and active business role. Does not grant session assurance or bypass owner MFA. Inactive or missing business profiles return role null.",
        "responses": {
          "200": {
            "description": "Verified session identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardMe"
                }
              }
            }
          },
