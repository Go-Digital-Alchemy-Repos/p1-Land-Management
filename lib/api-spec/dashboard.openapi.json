  "components": {
    "schemas": {
      "FieldOperation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workOrderId": {
            "type": "string",
            "format": "uuid"
          },
          "baseVersion": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "note",
              "issue",
              "time",
              "checklist",
              "complete"
            ]
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "payload": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "enum": [
                  "start",
                  "stop",
                  "break",
                  "travel"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "done": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "label",
                    "done"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "id",
          "workOrderId",
          "baseVersion",
          "kind",
          "payload",
          "capturedAt"
        ]
      },
      "WorkOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "property_id": {
            "type": "string",
            "format": "uuid"
          },
          "property_name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "scheduled_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "address": {
            "type": "string"
          },
          "access_instructions": {
            "type": "string"
          },
          "checklist": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "done": {
                  "type": "boolean"
                }
              },
              "required": [
                "label",
                "done"
              ]
            }
          },
          "published": {
            "type": "boolean"
          },
          "assigned_to": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "property_id",
          "property_name",
          "title",
          "status"
        ],
        "description": "Authorized work projection. Clients receive only identity, property name, title, scheduled_at and public status; operational fields are absent, not null placeholders."
      },
      "FieldSyncResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "accepted",
                    "conflict"
                  ]
                }
              },
              "required": [
                "id",
                "status"
              ]
            }
          }
        },
        "required": [
          "results"
        ]
      },
      "DashboardError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "CommercialInquiry": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "reported_company_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "reported_property_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "contact_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "property_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "acreage_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "project_stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "service_timing": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_action": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "contacted",
              "qualified",
              "proposal",
              "won",
              "lost"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
