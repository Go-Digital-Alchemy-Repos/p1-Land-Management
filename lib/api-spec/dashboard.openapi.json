{
  "openapi": "3.1.0",
  "info": {
    "title": "P1Dashboard",
    "version": "0.1.0",
    "description": "Shared field, scheduling and commercial inbox contract. Other office routes remain documented in docs/dashboard/API.md."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/work-orders": {
      "get": {
        "operationId": "getMyWorkOrders",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WorkOrder"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Verified session required"
          },
          "403": {
            "description": "Access denied"
          },
          "409": {
            "description": "Record changed or operation conflict"
          }
        }
      }
    },
    "/field/sync": {
      "post": {
        "operationId": "syncFieldEvents",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldSyncResponse"
                }
              }
            }
          },
          "401": {
            "description": "Verified session required"
          },
          "403": {
            "description": "Access denied"
          },
          "409": {
            "description": "Record changed or operation conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "events": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/FieldOperation"
                    }
                  }
                },
                "required": [
                  "events"
                ]
              }
            }
          }
        }
      }
    },
    "/setup": {
      "get": {
        "operationId": "getSetupStatus",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "initialized": {
                      "type": "boolean"
                    },
                    "configured": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "initialized",
                    "configured"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Verified session required"
          },
          "403": {
            "description": "Access denied"
          },
          "409": {
            "description": "Record changed or operation conflict"
          }
        }
      }
    },
    "/commercial-inquiries": {
      "get": {
        "operationId": "listCommercialInquiries",
        "description": "Owner/manager/sales only. Cursor is bound to filters; discard it when filters change. Recent-first created_at/id ordering preserves microseconds.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommercialInquiryPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardError"
                }
              }
            }
          },
          "401": {
            "description": "Verified session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardError"
                }
              }
            }
          },
          "403": {
            "description": "Role or owner assurance required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardError"
                }
              }
            }
          },
          "404": {
            "description": "Record absent or private",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardError"
                }
              }
            }
          },
          "409": {
            "description": "Stale version or state conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "contacted",
                "qualified",
                "proposal",
                "won",
                "lost"
              ]
            }
          },
          {
            "name": "ownerId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Active owner ID or unassigned"
            }
          },
          {
            "name": "overdue",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          }
        ]
      }
    },
