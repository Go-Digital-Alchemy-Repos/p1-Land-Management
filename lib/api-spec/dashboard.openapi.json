{
  "openapi": "3.1.0",
  "info": {
    "title": "P1Dashboard",
    "version": "0.1.0",
    "description": "Initial shared field-client contract. Additional office routes are documented in docs/dashboard/API.md."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/work-orders": {
      "get": {
        "operationId": "getMyWorkOrders",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WorkOrder"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Verified session required"
          },
          "403": {
            "description": "Access denied"
          },
          "409": {
            "description": "Record changed or operation conflict"
          }
        }
      }
    },
    "/field/sync": {
      "post": {
        "operationId": "syncFieldEvents",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldSyncResponse"
                }
              }
            }
          },
          "401": {
            "description": "Verified session required"
          },
          "403": {
            "description": "Access denied"
          },
          "409": {
            "description": "Record changed or operation conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "events": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/FieldOperation"
                    }
                  }
                },
                "required": [
                  "events"
                ]
              }
            }
          }
        }
      }
    },
    "/setup": {
      "get": {
        "operationId": "getSetupStatus",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "initialized": {
                      "type": "boolean"
                    },
                    "configured": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "initialized",
                    "configured"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Verified session required"
          },
          "403": {
            "description": "Access denied"
          },
          "409": {
            "description": "Record changed or operation conflict"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FieldOperation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workOrderId": {
            "type": "string",
            "format": "uuid"
          },
          "baseVersion": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "note",
              "issue",
              "time",
              "checklist",
              "complete"
            ]
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "payload": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "enum": [
                  "start",
                  "stop",
                  "break",
                  "travel"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "done": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "label",
                    "done"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "id",
          "workOrderId",
          "baseVersion",
          "kind",
          "payload",
          "capturedAt"
        ]
      },
      "WorkOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "property_id": {
            "type": "string",
            "format": "uuid"
          },
          "property_name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "scheduled_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "address": {
            "type": "string"
          },
          "access_instructions": {
            "type": "string"
          },
          "checklist": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "done": {
                  "type": "boolean"
                }
              },
              "required": [
                "label",
                "done"
              ]
            }
          },
          "published": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "property_id",
          "property_name",
          "title",
          "status"
        ]
      },
      "FieldSyncResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "accepted",
                    "conflict"
                  ]
                }
              },
              "required": [
                "id",
                "status"
              ]
            }
          }
        },
        "required": [
          "results"
        ]
      }
    }
  }
}
