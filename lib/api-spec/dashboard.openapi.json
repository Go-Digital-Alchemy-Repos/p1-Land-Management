    "/work-orders/{id}/readiness": {
      "post": {
        "operationId": "updateWorkReadiness",
        "description": "Owner/manager/dispatch only. Operational property required. Version-locked draft/scheduled/delayed edits; accepted changes clear prior overrides and audit before/after. Unchanged requirements return400. Started/stale work returns409.",
        "responses": {
          "200": {
            "description": "Success",
