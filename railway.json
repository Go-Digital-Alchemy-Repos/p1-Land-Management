{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "PORT=4173 BASE_PATH=/ pnpm --filter @workspace/p1-website build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @workspace/p1-website serve",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
